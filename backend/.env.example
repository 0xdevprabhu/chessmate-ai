# ChessMate AI Backend Configuration

# Path to Stockfish executable (Optional - if omitted, auto-detects in backend/bin or PATH)
# Examples:
# Windows: STOCKFISH_PATH=./bin/stockfish.exe
# Linux:   STOCKFISH_PATH=/usr/games/stockfish
# macOS:   STOCKFISH_PATH=/opt/homebrew/bin/stockfish
STOCKFISH_PATH=./bin/stockfish.exe

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Engine Analysis Limits
DEFAULT_ANALYSIS_TIME=1.0
MAX_ANALYSIS_TIME=5.0
DEFAULT_ANALYSIS_DEPTH=18
MAX_ANALYSIS_DEPTH=25
ENGINE_THREADS=2
ENGINE_HASH_MB=64
